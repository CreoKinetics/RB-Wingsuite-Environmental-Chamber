        <mxCell id="bomSummary" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="BOM summary:\nCRYO-101 Statebourne Cryostor 60 - service/check pending\nH-101 Statebourne 3701004/3701006 - 1/2 in BSP hose, 1.2-1.5 m\nAD-101 reducer - 1/2 in BSP to 1/4 in BSPT, TBD\nT-101 relief tee - 1/4 in BSPT run + 1/4 in BSPT branch, TBD\nRV-101 HEROSE 06002 - 1/4 in BSPT male inlet, 3/8 in BSPT female outlet, 6 mm orifice, 1.5 barG\nT-102 gauge tee - 1/4 in BSPT run + gauge branch, TBD\nPI-101 pressure gauge - 0-4 barG preferred / 0-6 barG acceptable\nSV-101 Gems D2064-LN2-LU-C204 - 1/4-19 BSPT female ports, 1/8 in orifice, 375 psi, 24 VDC 15 W\nT-103/RV-102 optional downstream relief - same HEROSE spec if installed\nMV-101 cryogenic metering valve - 1/4 in target, TBD\nHX-101 coil - 1/4 in OD copper or 316/316L stainless tube\nVENT-101 always-open safe external vent" vertex="1">
          <mxGeometry height="300" width="900" x="720" y="500" as="geometry" />
        </mxCell>
