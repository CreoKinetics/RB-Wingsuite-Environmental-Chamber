        <mxCell id="branch2" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="t102" target="pi101"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="branch3" style="endArrow=block;html=1;rounded=0;strokeWidth=2;dashed=1;" edge="1" parent="1" source="t103" target="rv102"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="notes" value="Notes:\n- RV-101 protects the external section between V-101 and SV-101.\n- RV-102 is used if downstream hardware can isolate liquid.\n- Coil outlet path remains open to external vent.\n- Valve train to be mechanically supported.\n- Full detailed BOM is in diagrams/PID-001_LN2_Valve_Train_BOM.csv." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="650" height="135" as="geometry" /></mxCell>
        <mxCell id="bomSummary" value="BOM summary:\nCRYO-101 Statebourne Cryostor 60 - service/check pending\nH-101 Statebourne 3701004/3701006 - 1/2 in BSP hose, 1.2-1.5 m\nAD-101 reducer - 1/2 in BSP to 1/4 in BSPT, TBD\nT-101 relief tee - 1/4 in BSPT run + 1/4 in BSPT branch, TBD\nRV-101 HEROSE 06002 - 1/4 in BSPT male inlet, 3/8 in BSPT female outlet, 6 mm orifice, 1.5 barG\nT-102 gauge tee - 1/4 in BSPT run + gauge branch, TBD\nPI-101 pressure gauge - 0-4 barG preferred / 0-6 barG acceptable\nSV-101 Gems D2064-LN2-LU-C204 - 1/4-19 BSPT female ports, 1/8 in orifice, 375 psi, 24 VDC 15 W\nT-103/RV-102 optional downstream relief - same HEROSE spec if installed\nMV-101 cryogenic metering valve - 1/4 in target, TBD\nHX-101 coil - 1/4 in OD copper or 316/316L stainless tube\nVENT-101 always-open safe external vent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="500" width="900" height="300" as="geometry" /></mxCell>
        <mxCell id="titleBlock" value="Drawing: PID-001\nTitle: LN2 Valve Train Schematic\nProject: RB Wingsuite Environmental Chamber\nRevision: Draft A\nStatus: Working design" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="330" height="135" as="geometry" /></mxCell>
