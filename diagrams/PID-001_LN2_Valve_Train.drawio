        <mxCell id="notes" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=12;" value="Notes:\n- RV-101 protects the external section between V-101 and SV-101.\n- RV-102 is used if downstream hardware can isolate liquid.\n- Coil outlet path remains open to external vent.\n- Valve train to be mechanically supported.\n- Full detailed BOM is in diagrams/PID-001_LN2_Valve_Train_BOM.csv." vertex="1">
