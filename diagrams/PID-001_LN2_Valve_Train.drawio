        <mxCell id="title" value="PID-001 - LN2 Valve Train Schematic - Draft A" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry" /></mxCell>
        <mxCell id="cryo" value="Statebourne Cryostor 60\nCRYO-101" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="160" height="70" as="geometry" /></mxCell>
        <mxCell id="v101" value="V-101\nIntegral liquid outlet valve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="260" width="110" height="50" as="geometry" /></mxCell>
        <mxCell id="h101" value="H-101\nStatebourne LN2 hose\n1/2 in BSP" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="250" width="125" height="70" as="geometry" /></mxCell>
        <mxCell id="reducer" value="AD-101\nReducer\n1/2 in BSP to 1/4 in BSPT\nTBD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="250" width="140" height="70" as="geometry" /></mxCell>
        <mxCell id="t101" value="T-101\nRelief tee" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="735" y="265" width="65" height="45" as="geometry" /></mxCell>
        <mxCell id="t102" value="T-102\nGauge tee" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="875" y="265" width="65" height="45" as="geometry" /></mxCell>
        <mxCell id="sv101" value="SV-101\nGems D2064-LN2-LU-C204\n24 VDC NC solenoid\n1/4-19 BSPT F x F" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="245" width="155" height="85" as="geometry" /></mxCell>
        <mxCell id="t103" value="T-103\nOptional tee" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1190" y="265" width="70" height="45" as="geometry" /></mxCell>
        <mxCell id="mv101" value="MV-101\nCryogenic metering valve\nTBD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="255" width="140" height="65" as="geometry" /></mxCell>
        <mxCell id="hx101" value="HX-101\nInternal cooling coil\n1/4 in tube target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="255" width="130" height="65" as="geometry" /></mxCell>
        <mxCell id="vent101" value="VENT-101\nSafe external vent\nAlways open" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="255" width="130" height="65" as="geometry" /></mxCell>
        <mxCell id="rv101" value="RV-101\nHEROSE USS-06002.0200.0000\n1.5 barG thermal relief\n1/4 BSPT M in / 3/8 BSPT F out\n6 mm orifice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690" y="105" width="180" height="100" as="geometry" /></mxCell>
        <mxCell id="pi101" value="PI-101\nLocal pressure gauge\n0-4 or 0-6 barG\n1/4 BSP/BSPT target" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="130" width="105" height="75" as="geometry" /></mxCell>
        <mxCell id="rv102" value="RV-102\nOptional downstream relief\nHEROSE 06002\n1.5 barG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1160" y="120" width="150" height="80" as="geometry" /></mxCell>
